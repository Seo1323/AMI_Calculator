{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMI_Calculator",
  "version": "../package.json",
  "identifier": "com.seo1323.amicalculator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AMI Calculator",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Kalkulator rebalansowania portfela",
    "category": "Finance",
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Polish"
        ],
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "customLanguageFiles": {
          "Polish": "installer/Polish.nsh"
        },
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
